<%- include('layout', { body: `
<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <h2 class="card-title">✏️ Edit Review</h2>
        <form action="/reviews/<%= review.id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label class="form-label">Book Title <span style="color: red;">*</span></label>
            <input type="text" class="form-control" value="<%= review.bookTitle %>" readonly>
            <small class="form-text text-muted">Book title cannot be changed after creation.</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Author Name <span style="color: red;">*</span></label>
            <input type="text" name="authorName" class="form-control" value="<%= review.authorName %>" placeholder="Enter the author name" required>
            <div class="invalid-feedback">Author name is required.</div>
          </div>
          <div class="mb-3">
            <label class="form-label">Rating <span style="color: red;">*</span></label>
            <div class="input-group">
              <input type="number" name="rating" class="form-control" min="1" max="5" value="<%= review.rating %>" placeholder="1-5" required>
              <span class="input-group-text">/ 5</span>
            </div>
            <div class="invalid-feedback">Rating between 1 and 5 is required.</div>
            <small class="form-text text-muted">Please rate from 1 (lowest) to 5 (highest).</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Review Text <span style="color: red;">*</span></label>
            <textarea name="reviewText" class="form-control" rows="6" placeholder="Share your thoughts about this book..." required><%= review.reviewText %></textarea>
            <div class="invalid-feedback">Review text is required.</div>
          </div>
          <% if (error) { %><div class="alert alert-danger alert-dismissible fade show" role="alert"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
          <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Update Review</button>
            <a class="btn btn-secondary" href="/reviews/<%= review.id %>">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
` }) %>